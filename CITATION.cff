    family-names: Nauryzbayeva
    alias: nrzvb98
    orcid: "https://orcid.org/0009-0006-4316-3194"
repository-code: https://github.com/nrzvb98/LEXIMETRA
license: MIT
version: 0.2.0
date-released: "2026-08-12"
keywords:
  - reaction time
  - speech onset
  - voice onset time
  - picture naming task
  - psycholinguistics
  - voice activity detection
