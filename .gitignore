# Virtual environments (any arch/suffix variant, e.g. .venv-x86_64)
.venv*/

# Python build and cache artifacts
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
build/
dist/
*.spec

# macOS
.DS_Store

# Runtime data and user outputs. Both names: recordings analyzed before the
# rename keep `_hala_output`, and the pipeline's own result CSVs land in the
# `<stem>_output/` sidecar alongside the beep anomaly report. The sidecar is
# ignored as a directory as well as by the extensions inside it, so anything the
# pipeline grows later is covered without editing this file again.
*_output/
*_hala_output/
*_output*.csv
*_hala_output*.csv
*_Analysis_Results.csv
*_beep_pairing_report.csv

# Audio data: keep real participant/session audio out of git
*.wav
*.mp3
*.flac
*.m4a
*.m4v

# No exception for examples/audio/. The sample recording the regression gate
# runs on is a real voice recording, so it is not distributed with this public
# repository -- keep your local copy at examples/audio/trial_sample.m4a and the
# gate runs; without it those tests skip themselves.

# Source assets, not user data: the beep templates drive detection, and the
# vendored pipeline cannot run without them.
!src/leximetra/processing/templates/*.wav

# The frozen baselines are the sample session's derived timings -- the same data
# as the recording itself, so they live beside it locally rather than shipping
# here. Only the README, which explains what they are, is distributed.
tests/data/processing_baseline/*
!tests/data/processing_baseline/README.md
