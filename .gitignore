# Virtual environments (any arch/suffix variant, e.g. .venv-x86_64)
.venv*/

# Python build and cache artifacts
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
build/
dist/
*.spec

# macOS
.DS_Store

# Runtime data and user outputs. Both names: recordings analyzed before the
# rename keep `_hala_output`, and the pipeline's own result CSVs land in the
# `<stem>_output/` sidecar alongside the beep anomaly report.
*_output*.csv
*_hala_output*.csv
*_Analysis_Results.csv
*_beep_pairing_report.csv

# Audio data: keep real participant/session audio out of git
*.wav
*.mp3
*.flac
*.m4a
*.m4v

# Allow intentional examples
!examples/audio/*.m4a

# Source assets and test fixtures, not user data. The beep templates drive
# detection (the vendored pipeline cannot run without them) and the frozen
# baseline is what proves that pipeline was vendored faithfully.
!src/hala_rt/processing/templates/*.wav
!tests/data/**/*.csv
